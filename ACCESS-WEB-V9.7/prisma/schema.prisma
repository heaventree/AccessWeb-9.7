generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                       @id @default(autoincrement())
  email                   String                    @unique
  password                String
  name                    String?
  createdAt               DateTime                  @default(now()) @map("created_at")
  currentPeriodEnd        DateTime?                 @map("current_period_end")
  firstName               String?                   @map("first_name")
  isAdmin                 Boolean                   @default(false) @map("is_admin")
  lastName                String?                   @map("last_name")
  profileImageUrl         String?                   @map("profile_image_url")
  stripeCustomerId        String?                   @map("stripe_customer_id")
  stripeSubscriptionId    String?                   @map("stripe_subscription_id")
  subscriptionPlan        String                    @default("free") @map("subscription_plan")
  subscriptionStatus      String                    @default("active") @map("subscription_status")
  updatedAt               DateTime?                 @updatedAt @map("updated_at")
  cancellationReason      String?                   @map("cancellation_reason")
  cancelledAt             DateTime?                 @map("cancelled_at")
  timezone                String                    @default("UTC") @map("timezone")
  isTwoFactorEnabled      Boolean                   @default(false) @map("is_two_factor_enabled")
  twoFactorSecret         String?                   @map("two_factor_secret")
  twoFactorCode           String?                   @map("two_factor_code")
  twoFactorCodeExpiry     DateTime?                 @map("two_factor_code_expiry")
  paymentHistory          PaymentHistory[]
  siteConnections         SiteConnection[]
  apiKeys                 ApiKey[]
  securityLogs            SecurityLog[]
  notificationPreferences NotificationPreferences?
  notifications           Notification[]
  notificationDeliveries  NotificationDeliveryLog[]

  @@map("User")
}

model PricingPlan {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD") @db.VarChar(3)
  period      String   @default("month") @db.VarChar(20)
  features    Json
  isPopular   Boolean  @default(false) @map("is_popular")
  cta         String   @default("Get Started") @db.VarChar(50)
  variant     String   @default("outline") @db.VarChar(20)
  accentColor String   @default("text-primary") @map("accent_color") @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pricing_plans")
}

model PaymentHistory {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD") @db.VarChar(3)
  status           String   @db.VarChar(20)
  planName         String   @map("plan_name") @db.VarChar(100)
  stripePaymentId  String   @unique @map("stripe_payment_id") @db.VarChar(255)
  stripeCustomerId String?  @map("stripe_customer_id") @db.VarChar(255)
  paymentMethod    String?  @map("payment_method") @db.VarChar(50)
  description      String?
  receiptUrl       String?  @map("receipt_url") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_history")
}

model SiteConnection {
  id              Int          @id @default(autoincrement())
  userId          Int          @map("user_id")
  siteName        String       @map("site_name") @db.VarChar(100)
  siteUrl         String       @map("site_url") @db.VarChar(255)
  platform        String       @default("wordpress") @db.VarChar(50)
  apiToken        String?      @map("api_token") @db.VarChar(255)
  status          String       @default("inactive") @db.VarChar(20)
  isActive        Boolean      @default(false) @map("is_active")
  lastScanAt      DateTime?    @map("last_scan_at")
  scanFrequency   String       @default("weekly") @map("scan_frequency") @db.VarChar(20)
  autoScanEnabled Boolean      @default(false) @map("auto_scan_enabled")
  webhookUrl      String?      @map("webhook_url") @db.VarChar(255)
  config          Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  scanResults     ScanResult[]
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("site_connections")
}

model ScanResult {
  id               Int            @id @default(autoincrement())
  siteConnectionId Int            @map("site_connection_id")
  scanType         String         @default("accessibility") @map("scan_type") @db.VarChar(50)
  scanUrl          String         @map("scan_url") @db.VarChar(500)
  scanStatus       String         @default("completed") @map("scan_status") @db.VarChar(20)
  errorCount       Int            @default(0) @map("error_count")
  warningCount     Int            @default(0) @map("warning_count")
  noticeCount      Int            @default(0) @map("notice_count")
  score            Float?         @db.Real
  rawResults       Json           @map("raw_results")
  scanDuration     Int?           @map("scan_duration")
  userAgent        String?        @map("user_agent") @db.VarChar(255)
  screenCapture    String?        @map("screen_capture") @db.VarChar(500)
  scanReason       String?        @default("schedule") @map("scan_reason") @db.VarChar(50)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  siteConnection   SiteConnection @relation(fields: [siteConnectionId], references: [id], onDelete: Cascade)

  @@map("scan_results")
}

model ApiKey {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  name         String    @db.VarChar(100)
  keyId        String    @unique @map("key_id") @db.VarChar(50)
  keyHash      String    @map("key_hash") @db.VarChar(255)
  usageCount   Int       @default(0) @map("usage_count")
  rateLimit    Int       @default(1000) @map("rate_limit")
  isActive     Boolean   @default(true) @map("is_active")
  lastUsed     DateTime? @map("last_used")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model ApiUsage {
  id            Int      @id @default(autoincrement())
  apiKeyId      Int      @map("api_key_id")
  endpoint      String   @db.VarChar(100)
  requestCount  Int      @default(1) @map("request_count")
  responseTime  Float?   @map("response_time")
  statusCode    Int      @map("status_code")
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("api_usage")
}

model SecurityLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  eventType   String   @map("event_type") @db.VarChar(50)
  description String   @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_logs")
}

model NotificationPreferences {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique @map("user_id")
  emailNotifications     Boolean  @default(true) @map("email_notifications")
  browserNotifications   Boolean  @default(true) @map("browser_notifications")
  scanCompleted          Boolean  @default(true) @map("scan_completed")
  criticalIssues         Boolean  @default(true) @map("critical_issues")
  weeklyDigest           Boolean  @default(true) @map("weekly_digest")
  monthlyReports         Boolean  @default(false) @map("monthly_reports")
  usageAlerts            Boolean  @default(true) @map("usage_alerts")
  teamUpdates            Boolean  @default(false) @map("team_updates")
  renewalReminders       Boolean  @default(true) @map("renewal_reminders")
  paymentNotifications   Boolean  @default(true) @map("payment_notifications")
  securityAlerts         Boolean  @default(true) @map("security_alerts")
  usageThreshold         Int      @default(80) @map("usage_threshold")
  digestFrequency        String   @default("weekly") @map("digest_frequency") @db.VarChar(20)
  quietHoursStart        String?  @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd          String?  @map("quiet_hours_end") @db.VarChar(5)
  timezone               String   @default("UTC") @db.VarChar(50)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id                Int                       @id @default(autoincrement())
  userId            Int                       @map("user_id")
  type              String                    @db.VarChar(50)
  category          String                    @db.VarChar(50)
  title             String                    @db.VarChar(255)
  message           String
  actionUrl         String?                   @map("action_url") @db.VarChar(500)
  actionLabel       String?                   @map("action_label") @db.VarChar(100)
  priority          String                    @default("normal") @db.VarChar(20)
  isRead            Boolean                   @default(false) @map("is_read")
  readAt            DateTime?                 @map("read_at")
  metadata          Json?
  expiresAt         DateTime?                 @map("expires_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs      NotificationDeliveryLog[]

  @@index([userId, isRead])
  @@index([type])
  @@index([category])
  @@index([priority])
  @@map("notifications")
}

model NotificationTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  type        String   @db.VarChar(50)
  channel     String   @db.VarChar(20)
  subject     String?  @db.VarChar(255)
  content     String
  variables   Json?
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type, channel])
  @@map("notification_templates")
}

model NotificationDeliveryLog {
  id             Int          @id @default(autoincrement())
  notificationId Int          @map("notification_id")
  userId         Int          @map("user_id")
  channel        String       @db.VarChar(20)
  status         String       @db.VarChar(20)
  deliveredAt    DateTime?    @map("delivered_at")
  failureReason  String?      @map("failure_reason") @db.VarChar(255)
  retryCount     Int          @default(0) @map("retry_count")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId, channel])
  @@index([status])
  @@map("notification_delivery_log")
}


